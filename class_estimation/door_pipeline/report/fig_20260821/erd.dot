digraph G {
  rankdir=LR; fontname="Noto Sans CJK KR"; nodesep=0.4; ranksep=0.8; splines=true;
  node [shape=plaintext, fontname="Noto Sans CJK KR", fontsize=10];
  edge [fontname="Noto Sans CJK KR", fontsize=9, arrowhead=crow, arrowtail=none, dir=both];
  datasets [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#2F6DB5"><FONT COLOR="white"><B>datasets</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>name (UNIQUE)<BR ALIGN="LEFT"/>type real|synthetic|mixed<BR ALIGN="LEFT"/>num_classes · total_images<BR ALIGN="LEFT"/>base_path<BR ALIGN="LEFT"/>description<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  classes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#2F6DB5"><FONT COLOR="white"><B>classes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK dataset_id<BR ALIGN="LEFT"/>name · display_name<BR ALIGN="LEFT"/>model_name · part_type<BR ALIGN="LEFT"/>image_count · cad_available<BR ALIGN="LEFT"/>notes (라벨 정정 이력)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  images [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#2F6DB5"><FONT COLOR="white"><B>images</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK class_id · FK session_id<BR ALIGN="LEFT"/>rgb_path · depth_path<BR ALIGN="LEFT"/>width · height (NULL 허용)<BR ALIGN="LEFT"/>data_source camera|isaac_sim|augmented<BR ALIGN="LEFT"/>synced_local · is_valid<BR ALIGN="LEFT"/>split train|val|test<BR ALIGN="LEFT"/>captured_at<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  sessions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#C0392B"><FONT COLOR="white"><B>capture_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK dataset_id<BR ALIGN="LEFT"/>session_dir (UNIQUE)<BR ALIGN="LEFT"/>class_name (현장 입력 원본)<BR ALIGN="LEFT"/>camera_type · capture_method<BR ALIGN="LEFT"/>capture_interval_s · saved_pairs<BR ALIGN="LEFT"/>finished · stop_reason<BR ALIGN="LEFT"/>started_at · ended_at<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  models [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#7B4FA3"><FONT COLOR="white"><B>models</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>name · architecture<BR ALIGN="LEFT"/>in_channels · num_classes<BR ALIGN="LEFT"/>weights_path · onnx_path · trt_path<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  tsess [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#7B4FA3"><FONT COLOR="white"><B>training_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK dataset_id · FK model_id<BR ALIGN="LEFT"/>optimizer · lr · batch · epochs<BR ALIGN="LEFT"/>best_val_accuracy · best_epoch<BR ALIGN="LEFT"/>status<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  tmet [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#7B4FA3"><FONT COLOR="white"><B>training_metrics</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK session_id · epoch<BR ALIGN="LEFT"/>train_loss · val_loss · val_accuracy<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  evalr [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#7B4FA3"><FONT COLOR="white"><B>evaluation_results</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK session_id · model_id · dataset_id<BR ALIGN="LEFT"/>eval_type in_domain|cross_domain|inference_pipeline<BR ALIGN="LEFT"/>accuracy · f1_macro · confusion_matrix<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  aug [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#7B4FA3"><FONT COLOR="white"><B>augmentation_configs</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK session_id<BR ALIGN="LEFT"/>name · applied_to · parameters(JSON)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  datasets -> classes; classes -> images; datasets -> sessions; sessions -> images;
  datasets -> tsess; models -> tsess; tsess -> tmet; tsess -> evalr; models -> evalr; datasets -> evalr; tsess -> aug;
}
